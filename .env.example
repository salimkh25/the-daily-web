# Copy this file to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).

# --- Server ---
PORT=3000

# --- Database (local MongoDB) ---
MONGODB_URI=mongodb://127.0.0.1:27017/thedailyweb

# --- Sessions ---
# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Weather widget (OpenWeatherMap free tier, no credit card: https://openweathermap.org/api) ---
WEATHER_API_KEY=your-openweathermap-key
WEATHER_CITY=Haifa
WEATHER_UNITS=metric
# Optional: look the place up by coordinates instead of by name (WEATHER_CITY is then only the label).
# Useful for towns OpenWeatherMap doesn't know by name. An unknown city name falls back to Haifa.
# WEATHER_LAT=32.8056
# WEATHER_LON=35.1694
