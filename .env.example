# Copy this file to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (local MongoDB via Homebrew) ---
MONGODB_URI=mongodb://127.0.0.1:27017/thedailyweb

# --- Sessions ---
# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Weather widget (OpenWeatherMap free tier — no credit card) ---
# Sign up at https://openweathermap.org/api and paste the key here.
WEATHER_API_KEY=your-openweathermap-key
WEATHER_CITY=Tel Aviv
WEATHER_UNITS=metric
