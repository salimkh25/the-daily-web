<%# one row per article. rendered inside the dashboard AND on its own for the Ajax
    requests from editor-dashboard.js (GET /editor?...&partial=1), so the markup lives in one place %>
<% articles.forEach(function(article) { %>
    <li class="article-list-item">
      <div class="article-info">
        <div class="article-title-row">
          <h3><a href="/editor/articles/<%= article._id %>"><%= article.title || 'Untitled draft' %></a></h3>
        </div>
        <div class="article-meta-row">
          <span class="badge badge--genre"><%= article.category || 'No section' %></span>
          <span class="badge badge--views" title="<%= (article.viewsCount || 0).toLocaleString() %> total readers">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            <%= (article.viewsCount || 0).toLocaleString() %> clicks
          </span>
          <span class="meta">By <%= article.author ? article.author.displayName : 'Staff' %> · Updated <%= new Date(article.updatedAt).toLocaleDateString('en-GB') %></span>
        </div>
      </div>

      <div class="article-actions">
        <% if (article.publishedAt && article.status !== 'published') { %>
          <span class="badge badge--genre" title="Readers still see the last approved version">live</span>
        <% } %>
        <span class="chip chip--<%= article.status %>"><%= article.status %></span>

        <% if (article.status === 'pending') { %>
          <a href="/editor/articles/<%= article._id %>" class="btn btn--primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Review
          </a>
        <% } else { %>
          <a href="/editor/articles/<%= article._id %>" class="btn btn--secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Edit
          </a>
        <% } %>

        <% if (article.publishedAt) { %>
          <a href="/editor/articles/<%= article._id %>/stats" class="btn btn--secondary" title="View impact chart">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 15l3-3 3 3 4-5"/></svg>
            Stats
          </a>
        <% } %>

        <form action="/editor/articles/<%= article._id %>?_method=DELETE" method="POST" class="inline-form" onsubmit="return confirm('Permanently delete this article? This action cannot be undone.');">
          <button type="submit" class="btn btn--danger" aria-label="Delete article">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
            Delete
          </button>
        </form>
      </div>
    </li>
<% }) %>
