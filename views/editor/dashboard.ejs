<%- include('../partials/header', { title: 'Editor — The Daily Web' }) %>

<!-- [TODO — GUIDE step 10] Editor management area.
     Show ALL articles, filterable by status. For each pending article: view, edit, approve &
     publish, or return for corrections (with a required note), and delete.
     For an edit to an already-published article, show current-public vs pending-new. -->
<section class="workspace">
  <div class="workspace__head">
    <h1><span class="section-flag">Editor</span> All articles</h1>
  </div>
  
  <% if (articles && articles.length > 0) { %>
    <ul class="article-list">
      <% articles.forEach(function(article) { %>
        <li class="article-list-item">
          <div class="article-info">
            <h3><a href="/editor/articles/<%= article._id %>"><%= article.title || 'Untitled' %></a></h3>
            <p class="meta">By <%= article.author ? article.author.displayName : 'Unknown' %> · Last updated: <%= new Date(article.updatedAt).toLocaleDateString('en-GB') %></p>
          </div>
          <div class="article-actions">
            <span class="chip chip--<%= article.status %>"><%= article.status %></span>
            <% if (article.status === 'published') { %>
              <a href="/editor/articles/<%= article._id %>/stats" class="btn btn--secondary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 15l3-3 3 3 4-5"/></svg>Analytics</a>
            <% } %>
            <form action="/editor/articles/<%= article._id %>?_method=DELETE" method="POST" class="inline-form">
              <button type="submit" class="btn btn--danger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>Delete</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="muted">No articles in the system.</p>
  <% } %>
</section>

<%- include('../partials/footer') %>
