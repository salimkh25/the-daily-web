<%- include('../partials/header', { title: 'Impact Analytics — The Daily Web' }) %>

<!-- views over time for one article, with a marker at every update an editor published.
     the data comes from GET /api/articles/:id/stats, drawn by public/js/stats.js with Chart.js -->
<section class="workspace analytics">
  <div class="workspace__head">
    <div>
      <h1><span class="section-flag">Editor</span> Impact Analytics</h1>
      <p class="meta">
        <% if (article.publishedAt) { %>
          <a href="/article/<%= article._id %>" target="_blank" rel="noopener"><%= article.title %></a>
          · first published <%= new Date(article.publishedAt).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
          · <%= article.updateCount %> update<%= article.updateCount === 1 ? '' : 's' %> since
        <% } else { %>
          <%= article.title %> · not published yet
        <% } %>
      </p>
    </div>
    <a class="btn btn--secondary" href="/editor">Back to Dashboard</a>
  </div>

  <div class="card analytics__chart">
    <canvas id="impact-chart" data-article-id="<%= article._id %>" role="img" aria-label="Views of this article over time, with the published updates marked"></canvas>
    <p class="muted analytics__empty" id="chart-empty" hidden>No views recorded for this article yet.</p>
  </div>
  <p class="meta analytics__hint">Red line = views. Dark dashed line with ▲ = an editor approved &amp; published an update at that moment.</p>

  <section>
    <h2 class="section-flag-heading"><span class="section-flag">Before vs after</span> each update</h2>
    <ul class="impact-list" id="impact-list">
      <li class="muted">Loading…</li>
    </ul>
  </section>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="/js/stats.js" defer></script>

<%- include('../partials/footer') %>
