<%- include('../partials/header', { title: 'Staff — The Daily Web' }) %>

<!-- staff management for editors: list/search, add, edit and remove reporter & editor accounts.
     every action is checked on the server (editor role, can't delete yourself, etc). -->
<section class="workspace">
  <div class="workspace__head">
    <div>
      <h1><span class="section-flag">Editor</span> Staff</h1>
      <p class="meta">Reporters and editors who can log in to The Daily Web</p>
    </div>
    <a class="btn btn--secondary" href="/editor">Back to Dashboard</a>
  </div>

  <% if (error) { %><p class="notice notice--error" role="alert"><%= error %></p><% } %>
  <% if (success) { %><p class="notice notice--success" role="status"><%= success %></p><% } %>

  <details class="staff-add" <%= error ? 'open' : '' %>>
    <summary class="btn btn--primary">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      Add staff member
    </summary>
    <form class="staff-form" action="/editor/users" method="POST">
      <label class="field"><span class="field__label">Username</span>
        <input class="field__input" name="username" required minlength="3" maxlength="30" pattern="[A-Za-z0-9._\-]{3,30}" autocomplete="off" /></label>
      <label class="field"><span class="field__label">Display name (byline)</span>
        <input class="field__input" name="displayName" required maxlength="60" /></label>
      <label class="field"><span class="field__label">Role</span>
        <select class="field__input" name="role">
          <option value="reporter">Reporter</option>
          <option value="editor">Editor</option>
        </select></label>
      <label class="field"><span class="field__label">Password (min 6)</span>
        <input class="field__input" type="password" name="password" required minlength="6" autocomplete="new-password" /></label>
      <button class="btn btn--primary" type="submit">Create account</button>
    </form>
  </details>

  <form class="staff-search" action="/editor/users" method="GET" role="search">
    <input class="field__input" type="search" name="search" value="<%= search %>" placeholder="Search by username or name…" aria-label="Search staff" />
    <button class="btn btn--secondary" type="submit">Search</button>
  </form>

  <% if (users.length) { %>
    <ul class="article-list">
      <% users.forEach(function (u) { const isMe = String(u._id) === me; %>
        <li class="article-list-item staff-row">
          <div class="article-info">
            <h3><%= u.displayName %> <% if (isMe) { %><span class="muted">(you)</span><% } %></h3>
            <p class="meta">@<%= u.username %> · <%= u.articleCount %> article<%= u.articleCount === 1 ? '' : 's' %> · joined <%= new Date(u.createdAt).toLocaleDateString('en-GB') %></p>
          </div>
          <div class="article-actions">
            <span class="chip <%= u.role === 'editor' ? 'chip--published' : 'chip--draft' %>"><%= u.role %></span>
            <details class="staff-edit">
              <summary class="btn btn--secondary">Edit</summary>
              <form class="staff-form" action="/editor/users/<%= u._id %>?_method=PUT" method="POST">
                <label class="field"><span class="field__label">Display name</span>
                  <input class="field__input" name="displayName" value="<%= u.displayName %>" required maxlength="60" /></label>
                <label class="field"><span class="field__label">Role</span>
                  <select class="field__input" name="role" <%= isMe ? 'disabled' : '' %>>
                    <option value="reporter" <%= u.role === 'reporter' ? 'selected' : '' %>>Reporter</option>
                    <option value="editor" <%= u.role === 'editor' ? 'selected' : '' %>>Editor</option>
                  </select>
                  <% if (isMe) { %><input type="hidden" name="role" value="<%= u.role %>" /><% } %></label>
                <label class="field"><span class="field__label">New password (leave empty to keep)</span>
                  <input class="field__input" type="password" name="password" minlength="6" autocomplete="new-password" /></label>
                <button class="btn btn--primary" type="submit">Save</button>
              </form>
            </details>
            <% if (!isMe) { %>
              <form action="/editor/users/<%= u._id %>?_method=DELETE" method="POST" class="inline-form"
                    onsubmit="return confirm('Remove this staff account? This cannot be undone.');">
                <button class="btn btn--danger" type="submit">Delete</button>
              </form>
            <% } %>
          </div>
        </li>
      <% }); %>
    </ul>
  <% } else { %>
    <p class="muted">No staff members match "<%= search %>".</p>
  <% } %>
</section>

<%- include('../partials/footer') %>
