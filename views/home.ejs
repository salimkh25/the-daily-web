<%- include('partials/header') %>

<!-- page 1 of the feed is rendered here on the server; public/js/feed.js loads the next pages and
     re-queries /api/articles when the search, category, read filter or sort changes (no reload). -->
<div class="home">
  <div class="home__main">
    <!-- HERO: lead story + two secondary. -->
    <% if (hero && hero.length > 0) { %>
    <section class="hero">
      <article class="hero__lead card">
        <% if (hero[0].image) { %>
          <img class="card__media" src="<%= hero[0].image %>" alt="<%= hero[0].title %>" />
        <% } else { %>
          <div class="card__media card__media--placeholder"></div>
        <% } %>
        <div class="card__body">
          <span class="section-flag"><%= hero[0].category || 'Lead' %></span>
          <h1 class="hero__title"><a href="/article/<%= hero[0]._id %>"><%= hero[0].title %></a></h1>
          <p class="hero__summary"><%= hero[0].summary %></p>
          <p class="meta">By <%= hero[0].author ? hero[0].author.displayName : 'Staff' %> · <%= new Date(hero[0].publishedAt).toLocaleDateString('en-GB') %></p>
        </div>
      </article>

      <% if (hero.length > 1) { %>
      <div class="hero__side">
        <article class="card card--row">
          <% if (hero[1].image) { %>
            <img class="card__media" src="<%= hero[1].image %>" alt="<%= hero[1].title %>" />
          <% } else { %>
            <div class="card__media card__media--placeholder"></div>
          <% } %>
          <div class="card__body">
            <span class="section-flag"><%= hero[1].category || 'News' %></span>
            <h3 class="card__title"><a href="/article/<%= hero[1]._id %>"><%= hero[1].title %></a></h3>
            <p class="meta">By <%= hero[1].author ? hero[1].author.displayName : 'Reporter' %></p>
          </div>
        </article>
        <% if (hero.length > 2) { %>
        <article class="card card--row">
          <% if (hero[2].image) { %>
            <img class="card__media" src="<%= hero[2].image %>" alt="<%= hero[2].title %>" />
          <% } else { %>
            <div class="card__media card__media--placeholder"></div>
          <% } %>
          <div class="card__body">
            <span class="section-flag"><%= hero[2].category || 'News' %></span>
            <h3 class="card__title"><a href="/article/<%= hero[2]._id %>"><%= hero[2].title %></a></h3>
            <p class="meta">By <%= hero[2].author ? hero[2].author.displayName : 'Reporter' %></p>
          </div>
        </article>
        <% } %>
      </div>
      <% } %>
    </section>
    <% } %>

    <!-- TOOLS: filter by read status + sort. -->
    <div class="feed-tools">
      <select class="field__input" id="feed-seen" aria-label="Filter by read status">
        <option value="" <%= !currentSeen ? 'selected' : '' %>>All stories</option>
        <option value="unseen" <%= currentSeen === 'unseen' ? 'selected' : '' %>>Unread</option>
        <option value="seen" <%= currentSeen === 'seen' ? 'selected' : '' %>>Read</option>
      </select>
      <select class="field__input" id="feed-sort" aria-label="Sort by">
        <option value="date" <%= currentSort === 'date' ? 'selected' : '' %>>Newest</option>
        <option value="popular" <%= currentSort === 'popular' ? 'selected' : '' %>>Most popular</option>
      </select>
    </div>

    <!-- FEED: card grid (Flexbox flex-wrap). -->
    <h2 class="section-flag-heading"><span class="section-flag"><%= currentSearch ? `Search: "${currentSearch}"` : (currentCategory || 'Latest') %></span></h2>
    <div class="feed" id="feed">
      <% if (articles && articles.length > 0) { %>
        <% articles.forEach(function(article) { %>
          <article class="card">
            <% if (article.image) { %>
              <img class="card__media" src="<%= article.image %>" alt="<%= article.title %>" />
            <% } else { %>
              <div class="card__media card__media--placeholder"></div>
            <% } %>
            <div class="card__body">
              <span class="section-flag"><%= article.category %></span>
              <h3 class="card__title"><a href="/article/<%= article._id %>"><%= article.title %></a></h3>
              <p class="card__summary"><%= article.summary %></p>
              <p class="meta">By <%= article.author ? article.author.displayName : 'Reporter' %> · <%= new Date(article.publishedAt).toLocaleDateString('en-GB') %></p>
            </div>
          </article>
        <% }); %>
      <% } else { %>
        <p class="muted">No articles found.</p>
      <% } %>
    </div>
    <div class="feed-sentinel" id="feed-sentinel">Loading more…</div>
  </div>

  <!-- SIDEBAR: weather + most read. -->
  <aside class="home__side">
    <%- include('partials/weather') %>
    <section class="panel">
      <div class="panel__head"><span class="section-flag">Most read</span></div>
      <% if (typeof mostRead !== 'undefined' && mostRead && mostRead.length) { %>
        <ol class="ranklist">
          <% mostRead.forEach(function(a) { %>
            <li><a href="/article/<%= a._id %>"><%= a.title %></a></li>
          <% }); %>
        </ol>
      <% } else { %>
        <p class="muted">No articles yet.</p>
      <% } %>
    </section>
  </aside>
</div>

<script src="/js/feed.js" defer></script>
<%- include('partials/footer') %>
