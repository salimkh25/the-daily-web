<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'The Daily Web' %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'The Daily Web — breaking news, published fast.' %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;600;700;800;900&family=Merriweather:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <!-- Masthead — the signature red rule lives under it (see style.css .masthead). -->
  <header class="masthead">
    <div class="container masthead__inner">
      <a class="wordmark" href="/">The&nbsp;Daily&nbsp;<span class="wordmark__accent">Web</span></a>

      <!-- Title Bar Search -->
      <form class="masthead__search" action="/" method="GET" role="search">
        <svg class="masthead__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input class="field__input masthead__search-input" id="feed-search" name="search" type="search" placeholder="Search news articles…" aria-label="Search articles" value="<%= (typeof currentSearch !== 'undefined' && currentSearch) ? currentSearch : '' %>" autocomplete="off" />
      </form>

      <div class="masthead__utility">
        <span class="masthead__date"><%= new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' }) %></span>
        <% if (currentUser) { %>
          <a class="btn btn--ghost" href="/<%= currentUser.role %>"><%= currentUser.role === 'editor' ? 'Editor area' : 'My articles' %></a>
          <form action="/auth/logout" method="POST" class="inline-form">
            <button type="submit" class="btn btn--ghost">Log out</button>
          </form>
        <% } else { %>
          <a class="btn btn--ghost" href="/auth/login">Staff login</a>
        <% } %>
      </div>
    </div>
    <!-- The thick red rule: the signature element. -->
    <div class="masthead__rule"></div>
    <!-- Category nav (BBC-style). Real categories with dynamic active state -->
    <% 
      const activeCat = (typeof currentCategory !== 'undefined' && currentCategory) ? currentCategory.toLowerCase() : '';
      const navSections = [
        { name: 'World', slug: 'World' },
        { name: 'Politics', slug: 'Politics' },
        { name: 'Business', slug: 'Business' },
        { name: 'Technology', slug: 'Technology', aliases: ['tech', 'technology'] },
        { name: 'Sport', slug: 'Sport', aliases: ['sport', 'sports'] },
        { name: 'Science', slug: 'Science' },
        { name: 'Health', slug: 'Health' },
        { name: 'Entertainment', slug: 'Entertainment', aliases: ['entertainment', 'culture'] }
      ];
    %>
    <nav class="catnav" aria-label="Sections">
      <div class="container catnav__inner">
        <a class="catnav__link <%= activeCat === '' ? 'is-active' : '' %>" href="/" data-category="">Home</a>
        <% navSections.forEach(function(sec) { 
             const isAct = sec.aliases 
               ? sec.aliases.includes(activeCat) 
               : activeCat === sec.slug.toLowerCase();
        %>
          <a class="catnav__link <%= isAct ? 'is-active' : '' %>" href="/?category=<%= sec.slug %>" data-category="<%= sec.slug %>"><%= sec.name %></a>
        <% }); %>
      </div>
    </nav>
  </header>

  <main class="container page">
