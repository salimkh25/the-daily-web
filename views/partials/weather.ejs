<!-- weather widget (sidebar). public/js/weather.js fills it from our own /api/weather endpoint,
     which calls OpenWeatherMap on the server and caches the answer for up to 15 minutes. -->
<aside class="panel weather" id="weather" aria-label="Local weather">
  <div class="panel__head"><span class="section-flag">Weather</span></div>
  <div class="weather__body" id="weather-body">
    <p class="muted">Loading...</p>
  </div>
</aside>

<script src="/js/weather.js" defer></script>
