<%- include('../partials/header', { title: 'My articles — The Daily Web' }) %>

<!-- [TODO — GUIDE step 9] Reporter workspace.
     Show ONLY this reporter's articles, grouped/filterable by status
     (draft / pending / published / returned). Show the editor's note on returned articles.
     Link to create new + edit. Status chips: see .chip styles in style.css. -->
<section class="workspace">
  <div class="workspace__head">
    <h1><span class="section-flag">Reporter</span> My articles</h1>
    <a class="btn btn--primary" href="/reporter/new">New article</a>
  </div>
  
  <% if (articles && articles.length > 0) { %>
    <ul class="article-list">
      <% articles.forEach(function(article) { %>
        <li class="article-list-item">
          <div class="article-info">
            <h3><a href="/reporter/articles/<%= article._id %>/edit"><%= article.title || 'Untitled' %></a></h3>
            <p class="meta">Last updated: <%= new Date(article.updatedAt).toLocaleDateString('en-GB') %></p>
            <% if (article.status === 'returned' && article.editorNote) { %>
              <p class="form-message form-message--error"><strong>Editor Note:</strong> <%= article.editorNote %></p>
            <% } %>
          </div>
          <div class="article-actions">
            <span class="chip chip--<%= article.status %>"><%= article.status %></span>
            <% if (article.status === 'draft' || article.status === 'returned' || article.status === 'published') { %>
              <form action="/reporter/articles/<%= article._id %>/submit" method="POST" style="display:inline;">
                <button type="submit" class="btn btn--secondary">Submit for Review</button>
              </form>
            <% } %>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="muted">You haven't written any articles yet.</p>
  <% } %>
</section>

<%- include('../partials/footer') %>
