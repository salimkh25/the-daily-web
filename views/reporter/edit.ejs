<%- include('../partials/header', { title: (isNew ? 'New article' : 'Edit article') + ' — The Daily Web' }) %>

<!-- create / edit form for reporters. there is no save button: public/js/editor.js autosaves to the
     server while typing, so a refresh, a closed browser or another computer never loses work.
     a pending article is locked (the server refuses edits too, not just these disabled fields). -->
<%
  const locked = article.status === 'pending';
  const categoryOptions = CATEGORIES.includes(article.category) || !article.category
    ? CATEGORIES
    : [article.category].concat(CATEGORIES); // keep an old non-standard category selectable
%>
<section class="editor-pane">
  <div class="workspace__head">
    <h1><span class="section-flag">Reporter</span> <%= isNew ? 'New article' : 'Edit article' %></h1>
    <% if (!isNew) { %>
      <span class="chip chip--<%= article.status %>"><%= article.status %></span>
    <% } %>
  </div>

  <% if (error) { %>
    <p class="notice notice--error" role="alert"><%= error %></p>
  <% } %>

  <% if (article.status === 'returned' && article.editorNote) { %>
    <div class="notice"><strong>Editor's note:</strong> <%= article.editorNote %></div>
  <% } %>

  <% if (locked) { %>
    <div class="notice">This article is waiting for editor review, so it is locked. You can edit it again if the editor returns it for fixes.</div>
  <% } else if (article.publishedAt) { %>
    <div class="notice">
      <strong>This article is live.</strong> Your edits are saved privately — readers keep seeing the approved version
      until you submit the changes and an editor approves them.
    </div>
  <% } %>

  <% if (!locked) { %>
    <p id="autosave-indicator" class="meta" role="status" aria-live="polite">
      <%= isNew ? 'Start typing — your draft saves automatically.' : 'All changes saved.' %>
    </p>
  <% } %>

  <form id="article-form" method="POST"
        action="<%= isNew ? '/reporter/articles' : `/reporter/articles/${article._id}?_method=PUT` %>"
        data-article-id="<%= isNew ? '' : article._id %>">
    <label class="field">
      <span class="field__label">Title</span>
      <input class="field__input" type="text" name="title" maxlength="160" value="<%= article.title || '' %>" <%= locked ? 'disabled' : '' %> />
    </label>

    <label class="field">
      <span class="field__label">Category</span>
      <select class="field__input" name="category" <%= locked ? 'disabled' : '' %>>
        <option value="" <%= !article.category ? 'selected' : '' %>>Choose a section…</option>
        <% categoryOptions.forEach(function (c) { %>
          <option value="<%= c %>" <%= article.category === c ? 'selected' : '' %>><%= c %></option>
        <% }); %>
      </select>
    </label>

    <label class="field">
      <span class="field__label">Image URL (optional)</span>
      <input class="field__input" type="url" name="image" maxlength="500" value="<%= article.image || '' %>" <%= locked ? 'disabled' : '' %> />
    </label>

    <label class="field">
      <span class="field__label">Summary (1-2 lines)</span>
      <textarea class="field__input" name="summary" rows="2" maxlength="400" <%= locked ? 'disabled' : '' %>><%= article.summary || '' %></textarea>
    </label>

    <label class="field">
      <span class="field__label">Content <span class="muted">(leave an empty line between paragraphs)</span></span>
      <textarea class="field__input" name="body" rows="15" <%= locked ? 'disabled' : '' %>><%= article.body || '' %></textarea>
    </label>
  </form>

  <% if (!locked) { %>
    <!-- separate form so pressing enter in a field can never submit the article by accident.
         editor.js saves any pending changes first, then lets this submit go through. -->
    <form id="submit-form" class="review-actions" method="POST"
          action="<%= isNew ? '' : `/reporter/articles/${article._id}/submit` %>" <%= isNew ? 'hidden' : '' %>>
      <span class="meta">Ready? Send it to an editor for approval — you can't publish it yourself.</span>
      <button type="submit" class="btn btn--primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
        Submit for review
      </button>
    </form>
    <script src="/js/editor.js" defer></script>
  <% } %>

  <p><a href="/reporter">← Back to my articles</a></p>
</section>

<%- include('../partials/footer') %>
